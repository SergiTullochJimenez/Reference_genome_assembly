# Now we have to prepare the file to manually curate it through Pretext. Up to today, only the coverage file seems to bea lways working. The gap file sometimes works, and the Telomers are giving headaches:

#!/bin/bash

# Set your paths
WD="/home/panthera/DiscoF/CBP/Macroprotodon_brevis"
indir=${WD}"/res/03.2.Scaffolding"        # Folder containing the .fa files
outbase=${WD}"/res/04.1.Pretext"     # Parent output directory
source="/mnt/DiscoB/naja/genome/old/scaffolding/output_salsa/"
fq1=${WD}/res/01.1.Trimming/filtered_Arima_HIC_1.fq.gz
fq2=${WD}/res/01.1.Trimming/filtered_Arima_HIC_2.fq.gz

{
for version in consensus hap1 hap2; do
    ref=${indir}/${version}/scaffolds_FINAL.fasta
    outdir=${outbase}/${version}
    mkdir -p ${outdir}

    echo "Processing version: ${version}"


#Indexing and mapping reads against the scaffold
# bwa index $ref
# samtools faidx $ref
# bwa mem -t 30 ${ref} \
# $fq1 $fq2 \
# -R "@RG\tID:"hic"\tSM:"hic"" |samtools sort -n -O bam -o ${outdir}/hic.bam

#Pretextmap
samtools view -h ${outdir}/hic.bam | /home/panthera/software/miniconda/bin/PretextMap -o ${outdir}/out.pretext --sortby length --sortorder descend --mapq 10

bedtools bamtobed -i ${outdir}/hic.bam > ${outdir}/hic.bed
sort -k1,1 -k2,2n ${outdir}/hic.bed > ${outdir}/hic_sorted.bed

#GAPS (get the python script)
python ${source}/python_script.py --fasta $ref --gap ${outdir}/gaps.bed


#ACTIVATE the ' tidk ' environment!!!!



genome_fai="${ref}.fai"   # FAI file: scaffold<TAB>length
gaps_bed=${outdir}/"gaps.bed"             # Input: BED with gaps (no header)
out_bedgraph=${outdir}/"gaps_vs_background.bedgraph"

# Clean gaps file (remove header, ensure integer positions)
awk 'BEGIN{OFS="\t"} NR>1 {print $1, int($2), int($3)}' "$gaps_bed" | sort -k1,1 -k2,2n > ${outdir}/sorted_gaps.bed

# Generate the continuous bedgraph
> "$out_bedgraph"

while read scaffold length _; do
    prev_end=0
    awk -v scaffold="$scaffold" -v len="$length" -v OFS="\t" -v prev_end="$prev_end" '
    BEGIN { found = 0 }
    $1 == scaffold {
        found = 1
        # Background before the gap
        if ($2 > prev_end) {
            print scaffold, prev_end, $2, 1
        }
        # Gap itself
        print scaffold, $2, $3, 100
        prev_end = $3
    }
    END {
        if (found && prev_end < len) {
            print scaffold, prev_end, len, 1
        } else if (!found) {
            print scaffold, 0, len, 1
        }
    }' ${outdir}/sorted_gaps.bed >> "$out_bedgraph"
done < "$genome_fai"


#Telomers
source /home/panthera/miniconda3/etc/profile.d/conda.sh
conda activate tidk
# Step 1: Motif discovery (explore) → results go into $outdir/explore
tidk explore \
  --fasta $ref \
  -d ${outdir}/explore \
  -e tsv \
  --log \
  -o telo_genome_draft \
  --minimum 5 --maximum 12
# Step 2: Search for discovered motif (e.g., AAATCT) → results go into $outdir/search
tidk search \
  --fasta $ref \
  -d ${outdir}/search \
  -e csv \
  --log \
  -s AAATCT \
  -o telomeres_out

# Step 3: Plot from the search results → plot saved into $outdir/plots
tidk plot \
  --csv ${outdir}/search/telomeres_out_telomeric_repeat_windows.csv \
  --height 120 -w 800 \
  -o ${outdir}/plots/tidk-plot

conda deactivate

#for the coverage plot
cat ${outdir}/hic_sorted.bed | gawk '{print $1"\t"$2"\t"$3"\t"$3-$2}' > ${outdir}/hic_sorted.bedgraph
cut -f 1,2 ${ref}.fai > ${outdir}/chrom.sizes
bedtools genomecov -bga -i ${outdir}/hic_sorted.bed -g ${outdir}/chrom.sizes> ${outdir}/coverage.bedgraph
samtools view -h ${outdir}/hic.bam | /home/panthera/software/miniconda/bin/PretextMap -o ${outdir}/out.pretext
cat ${outdir}/gaps_vs_background.bedgraph | /home/panthera/conda-backup/miniconda3/bin/PretextGraph -i out.pretext -n gaps
#for adding a bedgraph into the pretext file:
cat ${outdir}/coverage.bedgraph | /home/panthera/conda-backup/miniconda3/bin/PretextGraph -i ${outdir}/out.pretext -n coverage -o ${outdir}/out_${version}.pretext
