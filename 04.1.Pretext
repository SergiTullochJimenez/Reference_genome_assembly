# Now we have to prepare the file to manually curate it through Pretext. Up to today, only the coverage file seems to bea lways working. The gap file sometimes works, and the Telomers are giving headaches:

#!/bin/bash
set -euo pipefail   # abort on error, on unset vars, and on failed pipe stages

species="Species_of_interest"
sp="${species}"
WD="/home/panthera/DiscoF/CBP/${sp}"
indir="${WD}/res/03.2.Scaffolding"     # Folder containing the .fa files
outbase="${WD}/res/04.1.Pretext"       # Parent output directory
source_dir="path_to_script"
fq1="${WD}/res/01.1.Trimming/filtered_Arima_HIC_1.fq.gz"
fq2="${WD}/res/01.1.Trimming/filtered_Arima_HIC_2.fq.gz"
THREADS=24
PRETEXTMAP="path_to/PretextMap"
PRETEXTGRAPH="path_to/PretextGraph"
PYTHON_GAPS="/path_to/python" 

mkdir -p "$outbase"

{
for version in consensus hap1 hap2; do
    ref="${indir}/${version}/_scaffolds_final.fa"
    outdir="${outbase}/${version}"
    mkdir -p "$outdir"
    echo "Processing version: ${version}"

    # Clean up intermediate pretext files on exit (success or failure),
    # keeping only the final merged file for this version.
    trap 'rm -f "${outdir}/out.pretext" "${outdir}/out_1.pretext" "${outdir}/out_2.pretext" "${outdir}/out_3.pretext"' EXIT

    #### 0. Indexing and mapping reads against the scaffold ####
    # Skip index build if it already exists
    [[ -f "${ref}.bwt" ]] || bwa index "$ref"
    [[ -f "${ref}.fai" ]] || samtools faidx "$ref"

    # Skip mapping if hic.bam already exists (idempotent reruns; this step is expensive)
    if [[ ! -f "${outdir}/hic.bam" ]]; then
        bwa mem -t "$THREADS" "$ref" "$fq1" "$fq2" \
            -R "@RG\tID:hic\tSM:hic" \
        | samtools sort -n -@ "$THREADS" -O bam -o "${outdir}/hic.bam" -
    else
        echo "hic.bam already exists, skipping mapping"
    fi

    #### 0.1 Create the reference Pretextmap ####
    if [[ ! -f "${outdir}/out.pretext" ]]; then
        samtools view -h "${outdir}/hic.bam" \
            | "$PRETEXTMAP" -o "${outdir}/out.pretext" --sortby length --sortorder descend --mapq 10
    else
        echo "out.pretext already exists, skipping PretextMap"
    fi

    bedtools bamtobed -i "${outdir}/hic.bam" > "${outdir}/hic.bed"
    sort -k1,1 -k2,2n "${outdir}/hic.bed" > "${outdir}/hic_sorted.bed"

    #### 1. CREATE GAPS BEDGRAPH ####
    "$PYTHON_GAPS" "${source_dir}/04a.python_script_gaps.py" --fasta "$ref" --gap "${outdir}/gaps.bed"
    [[ -s "${outdir}/gaps.bed" ]] || echo "WARNING: gaps.bed is empty" >&2

    genome_fai="${ref}.fai"
    gaps_bed="${outdir}/gaps.bed"
    out_bedgraph="${outdir}/gaps_vs_background.bedgraph"
    sorted_gaps="${outdir}/sorted_gaps.bed"
    chrom_sizes="${outdir}/chrom.sizes"

    cut -f1,2 "$genome_fai" | sort -k1,1 > "$chrom_sizes"

    # Clean gaps file (drop header, force integer coords), then sort
    awk 'BEGIN{OFS="\t"} NR>1 {print $1, int($2), int($3)}' "$gaps_bed" \
        | sort -k1,1 -k2,2n > "$sorted_gaps"

    # Single-pass replacement for the old per-scaffold awk loop:
    # background = genome minus gaps (score 1), gaps = score 100.
    # bedtools complement handles scaffolds with zero gaps automatically.
    bedtools complement -i "$sorted_gaps" -g "$chrom_sizes" \
        | awk 'BEGIN{OFS="\t"}{print $1,$2,$3,1}' > "${outdir}/bg.bed"
    awk 'BEGIN{OFS="\t"}{print $1,$2,$3,100}' "$sorted_gaps" > "${outdir}/gaps_scored.bed"
    cat "${outdir}/bg.bed" "${outdir}/gaps_scored.bed" \
        | sort -k1,1 -k2,2n > "$out_bedgraph"
    rm -f "${outdir}/bg.bed" "${outdir}/gaps_scored.bed"

    #### 2. Create telomere bedgraph ####
    # Explore candidate repeats first, then pick the most abundant one.
    

    mkdir -p "${outdir}/explore"
    explore_tsv="${outdir}/explore/explore_out.tsv"
    (cd "${outdir}/explore" && tidk explore "$ref" --minimum 5 --maximum 12 --log) > "$explore_tsv"

    telomere_motif=""
    if [[ -s "$explore_tsv" ]]; then
        # Sum every count column after the repeat name (robust to either
        # the older fwd/rev split or the newer single merged count column),
        # then take the most abundant repeat.
        telomere_motif=$(awk -F'\t' 'NR>1 {s=0; for(i=2;i<=NF;i++) s+=$i; print $1, s}' "$explore_tsv" \
            | sort -k2,2 -nr | head -1 | cut -d' ' -f1)
    fi

    if [[ -z "$telomere_motif" ]]; then
        echo "ERROR: could not determine a telomere repeat motif from tidk explore (${explore_tsv})" >&2
        exit 1
    fi
    echo "Using telomere motif: ${telomere_motif}"


#CHECK THE TELOMERE!!
    tidk search  "$ref" -d "${outdir}/search" -e tsv       --log -s "$telomere_motif" -o telomeres_out
    tidk search  "$ref" -d "${outdir}/search" -e bedgraph  --log -s "$telomere_motif" -o telomeres_out
    [[ -s "${outdir}/search/telomeres_out_telomeric_repeat_windows.bedgraph" ]] \
        || echo "WARNING: telomere bedgraph is empty" >&2

    mkdir -p "${outdir}/plots/tidk-plot"
    tidk plot -t "${outdir}/search/telomeres_out_telomeric_repeat_windows.tsv" \
        --height 120 -w 800 -o "${outdir}/plots/tidk-plot"

    #### 3. Create coverage plot bedgraph ####
    bedtools genomecov -bga -i "${outdir}/hic_sorted.bed" -g "$chrom_sizes" \
        > "${outdir}/coverage.bedgraph"
    [[ -s "${outdir}/coverage.bedgraph" ]] || echo "WARNING: coverage.bedgraph is empty" >&2

    #### 4. Create repetitive regions bedgraph ####
    mamba run -n RED python "${source_dir}/04b.repetitive_redmask.py" -i "$ref" -o "${outdir}/${sp}_rep_py2"
    awk 'BEGIN{OFS="\t"}{print $1,$2,$3,$3-$2}' "${outdir}/${sp}_rep_py2.repeats.bed" \
        > "${outdir}/${sp}_repeats.bedgraph"
    [[ -s "${outdir}/${sp}_repeats.bedgraph" ]] || echo "WARNING: repeats.bedgraph is empty" >&2

    #### 5. Add the bedgraphs from all analyses into the pretext file ####
    "$PRETEXTGRAPH" -i "${outdir}/out.pretext"   -n repeats   -o "${outdir}/out_1.pretext"   < "${outdir}/${sp}_repeats.bedgraph"
    "$PRETEXTGRAPH" -i "${outdir}/out_1.pretext" -n coverage  -o "${outdir}/out_2.pretext"   < "${outdir}/coverage.bedgraph"
    "$PRETEXTGRAPH" -i "${outdir}/out_2.pretext" -n telomeres -o "${outdir}/out_3.pretext"   < "${outdir}/search/telomeres_out_telomeric_repeat_windows.bedgraph"
    "$PRETEXTGRAPH" -i "${outdir}/out_3.pretext" -n gaps      -o "${outdir}/out_${version}.pretext" < "$out_bedgraph"
    # trap above removes out.pretext / out_1 / out_2 / out_3 on exit,
    # keeping only out_${version}.pretext
done
echo "Finished species ${sp}"
} 2>&1 | tee "${outbase}/Pretext.log"

samtools view -h ${outdir}/hic.bam | /home/panthera/software/miniconda/bin/PretextMap -o ${outdir}/out.pretext
cat ${outdir}/gaps_vs_background.bedgraph | PretextGraph -i out.pretext -n gaps
#for adding a bedgraph into the pretext file:
cat ${outdir}/coverage.bedgraph | PretextGraph -i ${outdir}/out.pretext -n coverage -o ${outdir}/out_${version}.pretext
