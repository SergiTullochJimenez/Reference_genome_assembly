# The mitochondrial genome isn't uploaded with the reference genome, but separately. In this script we can
# 1: find our mitochondrial scaffold, which may be doubled or tripled dues to the alignments. From here we can separate it from the genome, to keep it by itself and eliminate it from the reference
# 2: assemble the mitochondrial genome. It does give its problems

WD="/home/panthera/DiscoF/CBP/Macroprotodon_brevis"
indir=${WD}"/res/05.1.Masking"        # Folder containing the .fa files
outbase="res/05.3.Mitofinder"     # Parent output directory
THREADS=15
reads1="res/01.1.Trimming/filtered_ILLUMINA_1.fq.gz"
reads2="res/01.1.Trimming/filtered_ILLUMINA_2.fq.gz"
mkdir -p $outbase
ref=${indir}/genome.softmasked.fa.softmasked.fa
##CHANGE because here we have consensus but not in the rest

#To check if the mitogenome is within the assembly:
#/home/panthera/software/MitoFinder/mitofinder -j comprobation -s $ref -r /mnt/DiscoB/naja/genome/assembly/fasta/mitogenome/Crotalus_reference_mit.gb -o 2 -p $THREADS -m 24

makeblastdb -in $ref -dbtype nucl -out ${outbase}/ref_db

blastn -query ${outbase}/Macroprotodon_brevis_final_genes_NT.fasta \
       -db ${outbase}/ref_db \
       -out ${outbase}/mito_vs_ref.blast \
       -evalue 1e-20 \
       -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore" \
       -max_target_seqs 1 \
       -num_threads 8

