#This was run on a server
#!/bin/bash

########################################
# LOAD MODULES
########################################

########################################
# SETTINGS
########################################
# Extraemos SOLO la especie que le toca a esta tarea del array
species=$(sed -n "${SLURM_ARRAY_TASK_ID}p" /home/csic/bye/stj/data/species.txt)

WD="Working_directory"
OUT_DIR="${WD}/res/00.RepeatMasking/${species}"
THREADS=${SLURM_CPUS_PER_TASK}

echo "Processing task ${SLURM_ARRAY_TASK_ID}: ${species}..."

mkdir -p ${OUT_DIR}
cd ${OUT_DIR}

GENOME="/mnt/netapp1/Store_csbyestj/data/Genomes/${species}/${species}.genome.fa"
MASKED_GENOME="/mnt/netapp1/Store_csbyestj/data/Genomes/${species}/${species}.masked.fa"
MASKED_BED="/mnt/netapp1/Store_csbyestj/data/Genomes/${species}/${species}.masked.bed"
DB="${species}_repeats"

# Limpieza inicial (solo de esta especie, ya que estamos en su propia OUT_DIR)
rm -rf RM_* ${DB}*

########################################
# BUILD DATABASE & RUN
########################################
BuildDatabase -name ${DB} ${GENOME}

RepeatModeler -database ${DB} -threads ${THREADS}

########################################
# RUN REPEATMASKER
########################################
# Buscamos el consensi.fa.classified generado
CONS=$(ls RM_*/consensi.fa.classified | head -n 1)

RepeatMasker \
    -pa ${THREADS} \
    -lib ${CONS} \
    -gff \
    -dir ${OUT_DIR} \
    -xsmall \
    ${GENOME}



MASKED_INPUT="${OUT_DIR}/${species}.genome.fa.masked"
GFF_INPUT="${OUT_DIR}/${species}.genome.fa.out.gff"

# Copy soft-masked genome
cp "${MASKED_INPUT}" "${MASKED_GENOME}"

# Convert RepeatMasker GFF to BED
awk 'BEGIN{OFS="\t"} !/^#/ {split($9,a,";"); print $1, $4-1, $5, a[1]}' \
    "${GFF_INPUT}" > "${MASKED_BED}"

# Save GFF in genome directory
cp "${GFF_INPUT}" "/mnt/netapp1/Store_csbyestj/data/Genomes/${species}/${species}.masked.gff"

echo "Finished ${species}"
